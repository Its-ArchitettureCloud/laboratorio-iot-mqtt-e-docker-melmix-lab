    {
        "id": "c6f4d4f2b8a90001",
        "type": "function",
        "z": "705f28228aad9571",
        "name": "Cooldown alert 5 minuti",
        "func": "const payload = msg.payload || {};\nconst sensorId = payload.sensore || msg.topic || \"unknown\";\nconst now = Date.now();\nconst cooldownMs = 5 * 60 * 1000;\nconst alerts = flow.get(\"lastTemperatureAlerts\") || {};\nconst lastAlert = alerts[sensorId] || 0;\n\nif (now - lastAlert < cooldownMs) {\n    return null;\n}\n\nalerts[sensorId] = now;\nflow.set(\"lastTemperatureAlerts\", alerts);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,

    {
        "id": "f2f6f197b88a1001",
        "type": "function",
        "z": "705f28228aad9571",
        "name": "build dashboard table",
        "func": "const payload = msg.payload || {};\nconst sensorId = payload.sensore;\n\nif (!sensorId || typeof payload.temperatura === \"undefined\") {\n    return null;\n}\n\nconst readings = flow.get(\"sensorReadings\") || {};\n\nreadings[sensorId] = {\n    sensore: sensorId,\n    temperatura: Number(payload.temperatura).toFixed(1),\n    unita: payload.unita || \"C\",\n    protocollo: payload.protocollo || \"n/d\",\n    latency_ms: Number.isFinite(Number(payload.latency_ms))\n    ? Math.max(0, Math.round(Number(payload.latency_ms)))\n    : 0,\n    aggiornato: payload.timestamp || new Date().toISOString()\n};\n\nflow.set(\"sensorReadings\", readings);\n\nmsg.payload = Object.values(readings).sort((a, b) =>\n    a.sensore.localeCompare(b.sensore)\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1420,
        "y": 240,

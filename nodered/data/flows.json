    {
        "id": "ecddd05c42f9629e",
        "type": "function",
        "z": "705f28228aad9571",
        "name": "Normalizza HTTP",
        "func": "const now = Date.now();\nconst payload = msg.payload || {};\n\nconst timestamp = payload.timestamp || payload.sent_at || new Date().toISOString();\nconst sentAt = Date.parse(payload.sent_at || timestamp);\nconst latency = Number.isFinite(sentAt) ? now - sentAt : 0;\n\nmsg.payload = {\n    sensore: payload.sensore || payload.sensor_id || \"http-unknown\",\n    temperatura: Number(payload.temperatura),\n    unita: payload.unita || \"C\",\n    protocollo: \"http\",\n    timestamp,\n    latency_ms: latency\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,

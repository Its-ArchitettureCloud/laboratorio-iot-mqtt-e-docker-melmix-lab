    {
        "id": "f2f6f197b88a1001",
        "type": "function",
        "z": "705f28228aad9571",
        "name": "build dashboard table",
        "func": "const payload = msg.payload || {};\nconst parts = (msg.topic || '').split('/');\nconst sensorFromTopic = parts.length >= 4 ? parts[2] : undefined;\nconst sensorId = payload.sensore || sensorFromTopic;\n\nif (!sensorId || typeof payload.temperatura === 'undefined') {\n    return null;\n}\n\nconst readings = flow.get('sensorReadings') || {};\nreadings[sensorId] = {\n    sensore: sensorId,\n    temperatura: Number(payload.temperatura).toFixed(1),\n    unita: payload.unita || 'C',\n    topic: msg.topic,\n    aggiornato: payload.timestamp || new Date().toISOString()\n};\nflow.set('sensorReadings', readings);\n\nmsg.payload = Object.values(readings).sort((a, b) => a.sensore.localeCompare(b.sensore));\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 300,

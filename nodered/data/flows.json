    {
        "id": "17cac7c9060b1a56",
        "type": "function",
        "z": "705f28228aad9571",
        "name": "Prepara InfluxDB",
        "func": "const payload = msg.payload || {};\n\nif (!payload.sensore || typeof payload.temperatura === \"undefined\") {\n    return null;\n}\n\nmsg.measurement = \"temperatura\";\n\nmsg.payload = [\n    {\n        valore: Number(payload.temperatura),\n        latency_ms: Number.isFinite(Number(payload.latency_ms))\n            ? Math.max(0, Math.round(Number(payload.latency_ms)))\n            : 0\n    },\n    {\n        sensore: payload.sensore,\n        protocollo: payload.protocollo || \"n/d\"\n    }\n];\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,

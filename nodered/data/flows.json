    {
        "id": "b0859535fb750d35",
        "type": "function",
        "z": "705f28228aad9571",
        "name": "Normalizza MQTT",
        "func": "const now = Date.now();\nconst payload = msg.payload || {};\nconst parts = (msg.topic || \"\").split(\"/\");\nconst sensorFromTopic = parts.length >= 4 ? parts[2] : undefined;\n\nconst timestamp = payload.timestamp || new Date().toISOString();\nconst sentAt = Date.parse(timestamp);\nconst latency = Number.isFinite(sentAt) ? now - sentAt : 0;\n\nmsg.payload = {\n    sensore: payload.sensore || sensorFromTopic || \"mqtt-unknown\",\n    temperatura: Number(payload.temperatura),\n    unita: payload.unita || \"C\",\n    protocollo: \"mqtt\",\n    timestamp,\n    latency_ms: latency\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
